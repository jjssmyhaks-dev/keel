{
  "name": "authab",
  "version": "1.0.0",
  "private": true,
  "description": "Authab — identity, vault and governance for AI agents",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "npm run typecheck",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import tsx --test tests/signed-links.test.ts tests/plans.test.ts tests/policy.test.ts tests/invitations.test.ts tests/provider-health.test.ts tests/runtime-config.test.ts tests/gmail.test.ts tests/mcp-gateway.test.ts tests/openapi-compile.test.ts tests/dpop.test.ts tests/oauth-refresh.test.ts tests/totp.test.ts tests/rbac.test.ts tests/slo.test.ts tests/status.test.ts tests/sandbox.test.ts tests/redaction.test.ts tests/billing.test.ts tests/identity-document.test.ts tests/revocations.test.ts tests/agent-events.test.ts tests/policy-events.test.ts tests/data-contribution.test.ts tests/consent.test.ts tests/consent-safety.test.ts tests/trust.test.ts tests/secret-patterns.test.ts tests/config-apply.test.ts tests/openapi-routes.test.ts",
    "connectors:check": "tsx scripts/check-connectors.mts",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --env-file=.env --import tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && node --env-file=.env --import tsx prisma/seed.ts",
    "db:backup": "node --env-file=.env scripts/backup-db.mjs",
    "db:backfill-identity": "node --env-file=.env --import tsx scripts/backfill-identity-documents.mts",
    "db:restore": "node scripts/restore-db.mjs",
    "db:restore:dry": "node scripts/restore-db.mjs --dry-run",
    "loadtest": "node scripts/load-test.mjs",
    "setup": "prisma generate && prisma migrate deploy",
    "sdk:build": "tsc -p sdk/tsconfig.json",
    "sdk:test": "node sdk/test/smoke.mjs && node sdk/test/ai.mjs",
    "cli:build": "node cli/scripts/build.mjs",
    "cli:typecheck": "tsc -p cli/tsconfig.json --noEmit",
    "mcp:build": "node mcp/scripts/build.mjs",
    "mcp:typecheck": "tsc -p mcp/tsconfig.json --noEmit",
    "python:test": "python -m unittest discover -s python/tests -v",
    "provider:validate": "node scripts/validate-provider.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@neon/config": "^1.10.0",
    "@neon/env": "^1.6.8",
    "@node-saml/node-saml": "^5.2.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.1",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-node": "^0.301.1",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-accordion": "latest",
    "@radix-ui/react-alert-dialog": "latest",
    "@radix-ui/react-aspect-ratio": "latest",
    "@radix-ui/react-avatar": "latest",
    "@radix-ui/react-checkbox": "latest",
    "@radix-ui/react-collapsible": "latest",
    "@radix-ui/react-context-menu": "latest",
    "@radix-ui/react-dialog": "latest",
    "@radix-ui/react-dropdown-menu": "latest",
    "@radix-ui/react-hover-card": "latest",
    "@radix-ui/react-label": "latest",
    "@radix-ui/react-menubar": "latest",
    "@radix-ui/react-navigation-menu": "latest",
    "@radix-ui/react-popover": "latest",
    "@radix-ui/react-progress": "latest",
    "@radix-ui/react-radio-group": "latest",
    "@radix-ui/react-scroll-area": "latest",
    "@radix-ui/react-select": "latest",
    "@radix-ui/react-separator": "latest",
    "@radix-ui/react-slider": "latest",
    "@radix-ui/react-slot": "latest",
    "@radix-ui/react-switch": "latest",
    "@radix-ui/react-tabs": "latest",
    "@radix-ui/react-toast": "latest",
    "@radix-ui/react-toggle": "latest",
    "@radix-ui/react-toggle-group": "latest",
    "@radix-ui/react-tooltip": "latest",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.0.4",
    "date-fns": "4.1.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "jose": "^6.2.14",
    "lucide-react": "latest",
    "next": "^16.4.6",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "react": "^19",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19",
    "react-hook-form": "^7.60.0",
    "react-resizable-panels": "^4.15.3",
    "recharts": "2.15.4",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.3.1",
    "vaul": "^1.1.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.9",
    "@types/node": "^22",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "pg": "^8.23.1",
    "postcss": "^8.5",
    "prisma": "6.19.3",
    "tailwindcss": "^4.1.9",
    "tsx": "^4.20.0",
    "tw-animate-css": "1.3.3",
    "typescript": "^5"
  }
}
