generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id                   String         @id @default(cuid())
  email                String         @unique
  name                 String
  passwordHash         String?
  avatarUrl            String?
  timezone             String         @default("Asia/Kolkata")
  emailVerifiedAt      DateTime?
  twoFactorSecret      String?
  twoFactorDataKey     String?
  twoFactorEnabledAt   DateTime?
  mfaRecoveryCodesJson String         @default("[]")
  notificationPrefs    String         @default("{}")
  isPlatformAdmin      Boolean        @default(false)
  onboardedAt          DateTime?
  createdAt            DateTime       @default(now())
  deletedAt            DateTime?
  memberships          Membership[]
  sessions             Session[]
  ownedAgents          Agent[]        @relation("AgentOwner")
  notifications        Notification[]
  ssoIdentities        SsoIdentity[]
}

model Session {
  id              String    @id
  userId          String
  tokenHash       String    @unique
  device          String?
  ip              String?
  userAgent       String?
  authMethod      String    @default("password")
  ssoConnectionId String?
  mfaVerifiedAt   DateTime?
  lastSeen        DateTime  @default(now())
  expiresAt       DateTime
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LoginToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  type      String
  email     String?
  userId    String?
  orgId     String?
  role      String?
  metaJson  String    @default("{}")
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

model ChallengeUse {
  id      String   @id @default(cuid())
  key     String   @unique
  agentId String
  usedAt  DateTime @default(now())

  @@index([agentId])
  @@index([usedAt])
}

model MfaUse {
  id        String   @id @default(cuid())
  key       String   @unique
  userId    String
  usedAt    DateTime @default(now())

  @@index([userId])
  @@index([usedAt])
}

model RateLimitCounter {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime

  @@index([resetAt])
}

model Organization {
  id                   String          @id @default(cuid())
  name                 String
  slug                 String          @unique
  plan                 String          @default("free")
  planStatus           String          @default("active")
  billingCurrency      String          @default("USD")
  billingEmail         String?
  billingAddressJson   String          @default("{}")
  taxId                String?
  trialEndsAt          DateTime?
  dunningStartedAt     DateTime?
  requireMfa           Boolean         @default(false)
  requireSso           Boolean         @default(false)
  dataContributionEnabled Boolean      @default(true)
  ssoDefaultRole       String          @default("developer")
  stripeCustomerId     String?         @unique
  stripeSubscriptionId String?
  logoUrl              String?
  createdAt            DateTime        @default(now())
  deletedAt            DateTime?
  memberships          Membership[]
  projects             Project[]
  invitations          Invitation[]
  usageRecords         UsageRecord[]
  invoices             Invoice[]
  notifications        Notification[]
  ssoConnections       SsoConnection[]
  scimTokens           ScimToken[]
  auditSinks           AuditSink[]
  errorEvents          ErrorEvent[]
}

model Membership {
  id              String       @id @default(cuid())
  orgId           String
  userId          String
  role            String
  permissionsJson String       @default("[]")
  status          String       @default("active")
  scimExternalId  String?
  deactivatedAt   DateTime?
  createdAt       DateTime     @default(now())
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([scimExternalId])
}

model SsoConnection {
  id               String        @id @default(cuid())
  orgId            String
  name             String
  type             String
  domainsJson      String        @default("[]")
  defaultRole      String        @default("developer")
  groupMappingJson String        @default("{}")
  configEncrypted  String
  configDataKey    String
  enabled          Boolean       @default(true)
  enforced         Boolean       @default(false)
  createdBy        String?
  lastLoginAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  org              Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  identities       SsoIdentity[]

  @@index([orgId])
}

model SsoIdentity {
  id           String        @id @default(cuid())
  connectionId String
  userId       String
  subject      String
  email        String
  createdAt    DateTime      @default(now())
  lastLoginAt  DateTime      @default(now())
  connection   SsoConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([connectionId, subject])
  @@index([userId])
}

model ScimToken {
  id         String       @id @default(cuid())
  orgId      String
  name       String
  tokenHash  String       @unique
  prefix     String
  createdBy  String?
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime     @default(now())
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model AuditSink {
  id              String              @id @default(cuid())
  orgId           String
  name            String
  type            String
  url             String
  secretEncrypted String?
  secretDataKey   String?
  enabled         Boolean             @default(true)
  lastDeliveryAt  DateTime?
  failureCount    Int                 @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  org             Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  deliveries      AuditSinkDelivery[]

  @@index([orgId])
}

model AuditSinkDelivery {
  id            String    @id @default(cuid())
  sinkId        String
  eventId       String
  environmentId String
  seq           Int
  statusCode    Int?
  attempt       Int       @default(1)
  nextRetryAt   DateTime?
  deliveredAt   DateTime?
  error         String?
  createdAt     DateTime  @default(now())
  sink          AuditSink @relation(fields: [sinkId], references: [id], onDelete: Cascade)

  @@unique([sinkId, eventId])
  @@index([sinkId, environmentId, seq])
  @@index([nextRetryAt])
}

model Incident {
  id         String           @id @default(cuid())
  title      String
  component  String
  impact     String           @default("minor")
  status     String           @default("investigating")
  body       String
  startedAt  DateTime         @default(now())
  resolvedAt DateTime?
  createdBy  String?
  createdAt  DateTime         @default(now())
  updates    IncidentUpdate[]

  @@index([startedAt])
}

model IncidentUpdate {
  id         String   @id @default(cuid())
  incidentId String
  status     String
  body       String
  createdAt  DateTime @default(now())
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
}

model ErrorEvent {
  id            String        @id @default(cuid())
  orgId         String?
  environmentId String?
  requestId     String
  traceId       String?
  route         String
  method        String?
  message       String
  digest        String?
  stack         String?
  userAgent     String?
  ip            String?
  userId        String?
  resolvedAt    DateTime?
  createdAt     DateTime      @default(now())
  org           Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([orgId, createdAt])
}

model Invitation {
  id         String       @id @default(cuid())
  orgId      String
  email      String
  role       String
  tokenHash  String       @unique
  invitedBy  String?
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime     @default(now())
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model Project {
  id           String        @id @default(cuid())
  orgId        String
  name         String
  keyEncrypted String?
  archivedAt   DateTime?
  createdAt    DateTime      @default(now())
  org          Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  environments Environment[]

  @@index([orgId])
}

model Environment {
  id                   String              @id @default(cuid())
  projectId            String
  type                 String
  settingsJson         String              @default("{}")
  productionUnlockedAt DateTime?
  createdAt            DateTime            @default(now())
  project              Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  apiKeys              ApiKey[]
  agents               Agent[]
  credentials          Credential[]
  grants               Grant[]
  approvalPolicies     ApprovalPolicy[]
  approvalRequests     ApprovalRequest[]
  auditEvents          AuditEvent[]
  webhooks             WebhookEndpoint[]
  alerts               AlertRule[]
  delegations          Delegation[]
  permissionChanges    PermissionChange[]
  idempotencyKeys      IdempotencyRecord[]
  oauthApps            OAuthApp[]
  workloadIdentities   WorkloadIdentity[]
  customConnectors     CustomConnector[]

  @@unique([projectId, type])
  @@index([projectId])
}

model OAuthApp {
  id                    String      @id @default(cuid())
  environmentId         String
  connectorSlug         String
  provider              String      @default("custom")
  clientId              String
  clientSecretEncrypted String
  dataKeyEncrypted      String
  authorizeUrl          String?
  tokenUrl              String?
  scopesJson            String      @default("[]")
  scopeSeparator        String      @default(" ")
  tokenAuth             String      @default("body")
  pkce                  Boolean     @default(true)
  extraAuthParamsJson   String      @default("{}")
  enabled               Boolean     @default(true)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  environment           Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@unique([environmentId, connectorSlug])
  @@index([environmentId])
}

model WorkloadIdentity {
  id                 String      @id @default(cuid())
  environmentId      String
  name               String
  type               String
  issuer             String
  audience           String
  jwksUrl            String?
  jwksJson           String?
  agentId            String?
  subjectPattern     String?
  requiredClaimsJson String      @default("{}")
  tokenTtlSeconds    Int         @default(300)
  enabled            Boolean     @default(true)
  createdAt          DateTime    @default(now())
  environment        Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@index([environmentId])
}

model DpopProofUse {
  id        String   @id
  jkt       String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model CustomConnector {
  id                   String                   @id @default(cuid())
  environmentId        String
  slug                 String
  name                 String
  description          String
  category             String                   @default("Custom")
  color                String                   @default("#333333")
  mark                 String                   @default("CU")
  version              Int                      @default(1)
  hostsJson            String
  baseUrl              String
  injectionJson        String
  credentialFieldsJson String                   @default("[]")
  actionsJson          String
  healthCheckJson      String?
  specVersion          String?
  specHash             String
  status               String                   @default("active")
  createdBy            String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  archivedAt           DateTime?
  environment          Environment              @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  versions             CustomConnectorVersion[]

  @@unique([environmentId, slug])
  @@index([environmentId])
}

model CustomConnectorVersion {
  id                   String          @id @default(cuid())
  customConnectorId    String
  version              Int
  name                 String
  description          String
  hostsJson            String
  baseUrl              String
  injectionJson        String
  credentialFieldsJson String          @default("[]")
  actionsJson          String
  healthCheckJson      String?
  specVersion          String?
  specHash             String
  createdBy            String?
  createdAt            DateTime        @default(now())
  connector            CustomConnector @relation(fields: [customConnectorId], references: [id], onDelete: Cascade)

  @@unique([customConnectorId, version])
  @@index([customConnectorId])
}

model ApiKey {
  id            String      @id @default(cuid())
  environmentId String
  name          String      @default("Default key")
  type          String
  keyHash       String      @unique
  prefix        String
  lastUsedAt    DateTime?
  revokedAt     DateTime?
  createdAt     DateTime    @default(now())
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@index([environmentId])
}

model Agent {
  id                  String              @id @default(cuid())
  environmentId       String
  name                String
  description         String?
  ownerUserId         String?
  status              String              @default("active")
  agentType           String              @default("other")
  verificationVisibility String          @default("public")
  publicKey           String?
  fingerprint         String
  keyMode             String              @default("platform")
  tagsJson            String              @default("[]")
  autonomousMode      Boolean             @default(false)
  safeLaunchUntil     DateTime?
  framework           String?
  promotedFromAgentId String?
  lastActiveAt        DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  environment         Environment         @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  owner               User?               @relation("AgentOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  keys                AgentKey[]
  clientSecrets       AgentClientSecret[]
  grants              Grant[]
  approvalPolicies    ApprovalPolicy[]
  approvalRequests    ApprovalRequest[]
  delegationsParent   Delegation[]        @relation("DelegationParent")
  delegationsChild    Delegation[]        @relation("DelegationChild")

  @@index([environmentId])
  @@index([ownerUserId])
}

model AgentKey {
  id                  String    @id @default(cuid())
  agentId             String
  publicKey           String
  encryptedPrivateKey String?
  status              String    @default("active")
  createdAt           DateTime  @default(now())
  rotatedAt           DateTime?
  retireAt            DateTime?
  agent               Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
}

model AgentClientSecret {
  id         String    @id @default(cuid())
  agentId    String
  label      String    @default("default")
  secretHash String    @unique
  prefix     String
  scopesJson String    @default("[]")
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  agent      Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
}

model Credential {
  id                String                  @id @default(cuid())
  environmentId     String
  connectorSlug     String
  name              String
  type              String
  encryptedPayload  String
  dataKeyEncrypted  String
  metadataJson      String                  @default("{}")
  maskedHint        String                  @default("")
  status            String                  @default("healthy")
  healthDetail      String?
  expiresAt         DateTime?
  lastUsedAt        DateTime?
  createdBy         String?
  revokedAt         DateTime?
  createdAt         DateTime                @default(now())
  oauthAppId        String?
  oauthScopes       String                  @default("[]")
  tokenEndpoint     String?
  tokenExpiresAt    DateTime?
  refreshable       Boolean                 @default(false)
  lastHealthCheckAt DateTime?
  environment       Environment             @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  grants            Grant[]
  approvalRequests  ApprovalRequest[]
  healthEvents      ConnectionHealthEvent[]

  @@index([environmentId])
  @@index([connectorSlug])
}

model ConnectionHealthEvent {
  id           String     @id @default(cuid())
  credentialId String
  result       String
  detail       String?
  checkedAt    DateTime   @default(now())
  credential   Credential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@index([credentialId])
}

model Grant {
  id               String            @id @default(cuid())
  environmentId    String
  agentId          String
  credentialId     String
  actionsJson      String            @default("[]")
  resourcePattern  String            @default("*")
  conditionsJson   String            @default("{}")
  approvalMode     String?
  purpose          String?
  expiresAt        DateTime?
  justInTime       Boolean           @default(false)
  activatedAt      DateTime?
  createdBy        String?
  createdAt        DateTime          @default(now())
  environment      Environment       @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  agent            Agent             @relation(fields: [agentId], references: [id], onDelete: Cascade)
  credential       Credential        @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  approvalRequests ApprovalRequest[]

  @@unique([agentId, credentialId])
  @@index([environmentId])
}

model ApprovalPolicy {
  id             String      @id @default(cuid())
  environmentId  String
  agentId        String?
  actionPattern  String
  mode           String
  slaMinutes     Int?
  escalateToRole String?
  createdAt      DateTime    @default(now())
  environment    Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  agent          Agent?      @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([environmentId, agentId])
}

model ApprovalRequest {
  id              String      @id @default(cuid())
  environmentId   String
  agentId         String
  grantId         String?
  credentialId    String?
  action          String
  summary         String
  payloadJson     String      @default("{}")
  redactedJson    String      @default("{}")
  risk            String      @default("write")
  status          String      @default("pending")
  decisionNote    String?
  token           String      @unique
  requestId       String
  executionResult String?
  kind            String      @default("action")
  grantSpecJson   String      @default("{}")
  slaDueAt        DateTime?
  escalatedAt     DateTime?
  expiresAt       DateTime
  decidedBy       String?
  decidedAt       DateTime?
  createdAt       DateTime    @default(now())
  environment     Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  agent           Agent       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  grant           Grant?      @relation(fields: [grantId], references: [id], onDelete: SetNull)
  credential      Credential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)

  @@index([environmentId, status])
  @@index([agentId])
}

model AuditEvent {
  id             String      @id @default(cuid())
  environmentId  String
  seq            Int
  timestamp      DateTime    @default(now())
  actorType      String
  actorId        String?
  actorName      String
  action         String
  resourceType   String
  resourceId     String?
  outcome        String
  requestId      String
  ip             String?
  agentId        String?
  payloadSummary String      @default("{}")
  chainJson      String      @default("[]")
  prevHash       String
  hash           String
  environment    Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@unique([environmentId, seq])
  @@index([environmentId, timestamp])
  @@index([agentId])
}

model TokenBlocklist {
  id        String   @id
  agentId   String
  expiresAt DateTime
  revokedAt DateTime @default(now())
}

model WebhookEndpoint {
  id             String            @id @default(cuid())
  environmentId  String
  url            String
  secret         String
  eventsJson     String            @default("[]")
  status         String            @default("active")
  lastDeliveryAt DateTime?
  createdAt      DateTime          @default(now())
  environment    Environment       @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  deliveries     WebhookDelivery[]
}

model WebhookDelivery {
  id          String          @id @default(cuid())
  webhookId   String
  eventId     String
  event       String
  payload     String
  statusCode  Int?
  attempt     Int             @default(1)
  nextRetryAt DateTime?
  deliveredAt DateTime?
  error       String?
  createdAt   DateTime        @default(now())
  webhook     WebhookEndpoint @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
}

model Promotion {
  id            String    @id @default(cuid())
  devAgentId    String
  prodAgentId   String?
  orgId         String
  diffJson      String    @default("{}")
  readinessJson String    @default("{}")
  approvedBy    String?
  status        String    @default("pending")
  createdAt     DateTime  @default(now())
  rolledBackAt  DateTime?
}

model PermissionChange {
  id            String      @id @default(cuid())
  environmentId String
  agentId       String
  credentialId  String?
  actorId       String?
  actorName     String
  change        String
  beforeJson    String      @default("{}")
  afterJson     String      @default("{}")
  createdAt     DateTime    @default(now())
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@index([environmentId, createdAt])
}

model UsageRecord {
  id        String       @id @default(cuid())
  orgId     String
  metric    String
  quantity  Int
  period    String
  createdAt DateTime     @default(now())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, metric, period])
}

model Invoice {
  id         String       @id @default(cuid())
  orgId      String
  number     String
  amount     Int
  currency   String
  status     String
  providerId String?
  hostedUrl  String?
  pdfUrl     String?
  paidAt     DateTime?
  issuedAt   DateTime     @default(now())
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model AlertRule {
  id            String      @id @default(cuid())
  environmentId String
  type          String
  configJson    String      @default("{}")
  channelsJson  String      @default("[]")
  enabled       Boolean     @default(true)
  lastFiredAt   DateTime?
  createdAt     DateTime    @default(now())
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String       @id @default(cuid())
  orgId     String
  userId    String?
  type      String
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime     @default(now())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user      User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
}

model Delegation {
  id               String      @id @default(cuid())
  environmentId    String
  parentAgentId    String
  childAgentId     String
  scopesJson       String      @default("[]")
  restrictionsJson String      @default("{}")
  depth            Int         @default(1)
  purpose          String?
  expiresAt        DateTime?
  revokedAt        DateTime?
  createdAt        DateTime    @default(now())
  environment      Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  parent           Agent       @relation("DelegationParent", fields: [parentAgentId], references: [id], onDelete: Cascade)
  child            Agent       @relation("DelegationChild", fields: [childAgentId], references: [id], onDelete: Cascade)

  @@index([environmentId])
}

model IdempotencyRecord {
  id            String      @id @default(cuid())
  environmentId String
  key           String
  requestHash   String
  statusCode    Int
  responseJson  String
  createdAt     DateTime    @default(now())
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@unique([environmentId, key])
}

model EndUser {
  id             String    @id @default(cuid())
  projectId      String
  externalUserId String
  email          String?
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?
  consents       Consent[]

  @@unique([projectId, externalUserId])
}

model AgentIdentityDocument {
  id           String    @id @default(cuid())
  agentId      String
  docSeq       Int
  documentJson String
  jws          String
  issuerKeyId  String
  issuedAt     DateTime  @default(now())
  supersededAt DateTime?

  @@unique([agentId, docSeq])
  @@index([agentId, supersededAt])
}

model Revocation {
  id            String   @id @default(cuid())
  environmentId String
  agentId       String   @unique
  reasonCode    String
  revokedAt     DateTime @default(now())

  @@index([environmentId, revokedAt])
}

model AgentEvent {
  id                  String   @id @default(cuid())
  schemaVersion       Int      @default(1)
  occurredAt          DateTime @default(now())
  environmentId       String
  organizationId      String
  agentId             String
  agentType           String
  requestId           String
  connectorSlug       String
  action              String
  riskClass           String
  resourceType        String
  decision            String
  decisionReasonCode  String
  approvalLatencyMs   Int?
  upstreamStatusClass String?
  latencyMs           Int?
  costUnits           Int      @default(1)
  delegationDepth     Int      @default(0)
  isSandbox           Boolean  @default(false)
  contributes         Boolean  @default(false)
  credentialId        String?

  @@index([environmentId, occurredAt])
  @@index([agentId, occurredAt])
  @@index([organizationId, occurredAt])
  @@index([connectorSlug, action])
}

model PolicyEvent {
  id                 String   @id @default(cuid())
  createdAt          DateTime @default(now())
  environmentId      String
  organizationId     String
  agentId            String
  agentType          String
  subject            String
  grantId            String?
  approvalPolicyId   String?
  connectorSlug      String?
  actionSetJson      String   @default("[]")
  resourceShape      String
  approvalMode       String?
  conditionKeysJson  String   @default("[]")
  changeKind         String
  changedFromEventId String?
  isSandbox          Boolean  @default(false)
  contributes        Boolean  @default(false)

  @@index([environmentId, createdAt])
  @@index([organizationId, createdAt])
}

model DataContributionChange {
  id             String   @id @default(cuid())
  organizationId String
  enabled        Boolean
  changedBy      String
  changedAt      DateTime @default(now())

  @@index([organizationId, changedAt])
}

model Consent {
  id                 String    @id @default(cuid())
  endUserId          String
  projectId          String
  agentId            String
  scopesJson         String    @default("[]")
  consentTextVersion String
  grantedAt          DateTime  @default(now())
  expiresAt          DateTime?
  revokedAt          DateTime?
  ip                 String?
  userAgent          String?
  endUser            EndUser   @relation(fields: [endUserId], references: [id], onDelete: Cascade)

  @@index([agentId])
}
