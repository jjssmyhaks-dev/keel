# Copy to .env and fill in. Never commit real secrets.
# Neon: `neon deploy` writes these automatically. Use the pooled URL for the
# app and the direct URL for migrations.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
APP_URL="http://localhost:3000"
MASTER_KEY=""
JWT_SIGNING_PRIVATE_KEY=""
AUTH_COOKIE_SECRET=""
JWT_ISSUER="https://keel.dev"
JWT_AUDIENCE="keel-api"
SESSION_TTL_DAYS="30"
# Social sign-in is hidden unless both values for a provider are set.
# Authorized redirect URIs: ${APP_URL}/auth/oauth/google/callback and ${APP_URL}/auth/oauth/github/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
RESEND_API_KEY=""
EMAIL_FROM="Keel <hello@keel.dev>"
STRIPE_SECRET_KEY=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
PLATFORM_ADMIN_EMAILS=""
# Scheduled webhook retries and cleanup endpoint: POST /api/cron/webhooks
CRON_SECRET=""
# Demo access is enabled automatically outside production. Set to 1 only on disposable demo deployments.
ALLOW_DEMO_LOGIN=""
ALLOW_DEMO_SEED=""
# Local-only escape hatch for webhook tests against localhost. Never enable in production.
KEEL_ALLOW_PRIVATE_WEBHOOKS=""
# Neon services (written by `neon deploy`; optional unless you call them)
NEON_AUTH_BASE_URL=""
NEON_AUTH_JWKS_URL=""
NEON_REALTIME_URL=""
NEON_REALTIME_SECRET=""
NEON_FUNCTION_HELLO_BASE_URL=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_ENDPOINT_URL_S3=""
AWS_REGION=""
